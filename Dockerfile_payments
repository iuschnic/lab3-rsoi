FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY ["./code/Payments.Api/Payments.Api.csproj", "Payments.Api/"]
COPY ["./code/Payments.Application/Payments.Application.csproj", "Payments.Application/"]
COPY ["./code/Payments.Domain/Payments.Domain.csproj", "Payments.Domain/"]
COPY ["./code/Payments.Storage/Payments.Storage.csproj", "Payments.Storage/"]
RUN dotnet restore "Payments.Api/Payments.Api.csproj"

COPY ["./code/Payments.Api", "Payments.Api/"]
COPY ["./code/Payments.Application", "Payments.Application/"]
COPY ["./code/Payments.Domain", "Payments.Domain/"]
COPY ["./code/Payments.Storage", "Payments.Storage/"]
WORKDIR "/src/Payments.Api"
RUN dotnet publish "Payments.Api.csproj" -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app/publish .

ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080

ENTRYPOINT ["dotnet", "Payments.Api.dll"]