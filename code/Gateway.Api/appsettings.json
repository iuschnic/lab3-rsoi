{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Services": {
    "Cars": {
      "BaseUrl": "http://localhost:8070",
      "FailureThreshold": 3,
      "BreakSeconds": 5,
      "TimeoutSeconds": 5,
      "SamplingSeconds":  30
    },
    "Payments": {
      "BaseUrl": "http://localhost:8050",
      "FailureThreshold": 3,
      "BreakSeconds": 5,
      "TimeoutSeconds": 5,
      "SamplingSeconds": 30
    },
    "Rentals": {
      "BaseUrl": "http://localhost:8060",
      "FailureThreshold": 3,
      "BreakSeconds": 5,
      "TimeoutSeconds": 5,
      "SamplingSeconds": 30
    }
  },
  "AllowedHosts": "*"
}
