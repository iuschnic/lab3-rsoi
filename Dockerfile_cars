FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY ["./code/Cars.Api/Cars.Api.csproj", "Cars.Api/"]
COPY ["./code/Cars.Application/Cars.Application.csproj", "Cars.Application/"]
COPY ["./code/Cars.Domain/Cars.Domain.csproj", "Cars.Domain/"]
COPY ["./code/Cars.Storage/Cars.Storage.csproj", "Cars.Storage/"]
RUN dotnet restore "Cars.Api/Cars.Api.csproj"

COPY ["./code/Cars.Api", "Cars.Api/"]
COPY ["./code/Cars.Application", "Cars.Application/"]
COPY ["./code/Cars.Domain", "Cars.Domain/"]
COPY ["./code/Cars.Storage", "Cars.Storage/"]
WORKDIR "/src/Cars.Api"
RUN dotnet publish "Cars.Api.csproj" -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app/publish .

ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080

ENTRYPOINT ["dotnet", "Cars.Api.dll"]