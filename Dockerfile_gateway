FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY ["./code/Gateway.Api/Gateway.Api.csproj", "Gateway.Api/"]
COPY ["./code/Gateway.Application/Gateway.Application.csproj", "Gateway.Application/"]
COPY ["./code/Gateway.Infrastructure/Gateway.Infrastructure.csproj", "Gateway.Infrastructure/"]
RUN dotnet restore "Gateway.Api/Gateway.Api.csproj"

COPY ["./code/Gateway.Api", "Gateway.Api/"]
COPY ["./code/Gateway.Application", "Gateway.Application/"]
COPY ["./code/Gateway.Infrastructure", "Gateway.Infrastructure/"]
WORKDIR "/src/Gateway.Api"
RUN dotnet publish "Gateway.Api.csproj" -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app/publish .

ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080

ENTRYPOINT ["dotnet", "Gateway.Api.dll"]